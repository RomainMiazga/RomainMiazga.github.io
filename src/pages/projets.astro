---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// On va chercher tous les fichiers .md dans le dossier "projects"
const allProjects = await getCollection('projects');

// On les trie selon le numéro "order" défini dans les fichiers .md
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Romain Miazga | Réalisations & Lab">
    <div class="glow-overlay"></div>
    
    <main>
        <header>
            <h1>Mes Réalisations <span>& Lab</span></h1>
            <p>Documentation technique de mes travaux à la Metz Numeric School et projets personnels.</p>
        </header>

        <section class="project-detail">
{sortedProjects.map((project) => (
    <div class="card hidden-scroll">
        {project.data.image && (
            <div class="card-image">
                <img src={project.data.image} alt={project.data.title} />
            </div>
        )}
        
        <div class="card-content">
            <span class="badge">{project.data.badge}</span>
            <h2>{project.data.title}</h2>
            <p>{project.data.description}</p>
            
            <ul>
                {project.data.bullets.map((bullet) => (
                    <li>{bullet}</li>
                ))}
            </ul>

            <a href={project.data.pdfLink} class="btn-pdf" target="_blank">
                Consulter la procédure (PDF) →
            </a>
        </div>
    </div>
))}
        </section>
    </main>
</Layout>

<style is:global>
    * { 
        box-sizing: border-box; 
    }
    
    body { 
        background: #050505; 
        color: #fff; 
        font-family: 'Plus Jakarta Sans', sans-serif; 
        margin: 0; 
    }
    
    main { 
        max-width: 900px; 
        margin: 0 auto; 
        padding: 8rem 2rem; 
    }
    
    header {
        animation: fadeIn 0.8s ease-out forwards;
    }
    
    h1 { 
        font-size: clamp(3rem, 8vw, 5rem); 
        font-weight: 800;
        margin-top: 0;
        margin-bottom: 1rem; 
        letter-spacing: -2px;
        background: linear-gradient(to bottom, #fff 40%, #888);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    h1 span { 
        background: linear-gradient(90deg, #00d2ff, #3a7bd5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }
    
    header p { 
        color: #a0a0a0; 
        font-size: 1.2rem; 
    }
    
    .project-detail { 
        margin-top: 4rem; 
        display: flex; 
        flex-direction: column; 
        gap: 2rem; 
    }
    
.card {
    padding: 0; /* On enlève le padding de la carte pour que l'image colle aux bords */
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
}

.card-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* L'image remplit le cadre sans se déformer */
    transition: transform 0.5s ease;
}

.card:hover .card-image img {
    transform: scale(1.1); /* Petit zoom au survol */
}

.card-content {
    padding: 1.5rem 2rem 2rem 2rem; /* On remet le padding ici */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
    
    .card h2 { 
        color: #00d2ff; 
        margin-top: 0; 
    }
    
    .card ul { 
        color: #888; 
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }
    
    .btn-pdf {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.6rem 1.2rem;
        background: rgba(0, 210, 255, 0.1);
        border: 1px solid #00d2ff;
        color: #00d2ff;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-pdf:hover {
        background: #00d2ff;
        color: #050505;
        transform: translateY(-2px);
    }
    
    .glow-overlay {
        position: fixed;
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%;
        background: radial-gradient(circle at 50% -20%, rgba(0, 210, 255, 0.15), transparent 50%);
        pointer-events: none;
        z-index: -1;
    }
    
    .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 5px 12px;
        background: rgba(255, 255, 255, 0.05);
        color: #888;
        border-radius: 100px;
        margin-bottom: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .card:hover .badge {
        color: #00d2ff;
        border-color: #00d2ff;
        background: rgba(0, 210, 255, 0.05);
    }

    ::-webkit-scrollbar {
        display: none;
    }

    * {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    footer { 
        margin-top: 10rem; 
        padding-bottom: 4rem; 
        text-align: center; 
        color: #444; 
    }
</style>