---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Romain Miazga | Réalisations</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navbar />
    
    <div class="glow-overlay"></div>
    
<main>
      <header>
        <h1>Mes Réalisations <span>& Lab</span></h1>
        <p>Documentation technique de mes travaux à la Metz Numeric School et projets personnels.</p>
      </header>

<section class="project-detail">
  <div class="card">
    <span class="badge">Déploiement & Sauvegarde</span>
    <h2>💿 Clonezilla</h2>
    <p>Sauvegarde et restauration avec CloneZilla sur VMware Workstation Pro</p>
    <ul>
      <li>Création d'une image disque complète</li>
      <li>Restauration de l'image sur un nouveau poste client</li>
    </ul>
    <a href="/Procedure-CloneZilla-Romain_Miazga.pdf" class="btn-pdf" target="_blank" aria-label="Consulter la procédure PDF pour Clonezilla">
      Consulter la procédure (PDF) →
    </a>
  </div>

  <div class="card">
    <span class="badge">Infrastructure & Stockage</span>
    <h2>🗄️ TrueNAS SCALE</h2>
    <p>Installation et configuration d'un serveur de stockage réseau</p>
    <ul>
      <li>Configuration du système et des pools de stockage</li>
      <li>Gestion fine des utilisateurs et des partages SMB via ACL</li>
    </ul>
    <a href="/Romain_Miazga-TrueNAS-ACL-SMB.pdf" class="btn-pdf" target="_blank" aria-label="Consulter la procédure PDF pour TrueNAS">
      Consulter la procédure (PDF) →
    </a>
  </div>

  <div class="card">
    <span class="badge">Système & Scripting</span>
    <h2>💾️ Gestion des disques / Diskpart</h2>
    <p>Prise en main de l'outil de Gestion des disques et de Diskpart</p>
    <ul>
      <li>Création et optimisation de volumes et de partitions</li>
      <li>Automatisation des étapes de création via script .txt</li>
    </ul>
    <a href="/Procedure-gestion-des-disques.pdf" class="btn-pdf" target="_blank" aria-label="Consulter la procédure PDF pour Diskpart">
      Consulter la procédure (PDF) →
    </a>
  </div>
</section>
    </main>
		<footer>
		<p>© {new Date().getFullYear()} — Romain Miazga • Fameck (57)</p>
	</footer>
  </body>
</html>

<style is:global>
* { 
    box-sizing: border-box; 
  }
  /* Styles de base */
  body { 
    background: #050505; 
    color: #fff; 
    font-family: 'Plus Jakarta Sans', sans-serif; 
    margin: 0; 
  }
  
  main { 
    max-width: 900px; 
    margin: 0 auto; 
    padding: 8rem 2rem; 
  }
  
  /* Header animé et textes */
  header {
    animation: fadeIn 0.8s ease-out forwards;
  }
  
  h1 { 
    font-size: clamp(3rem, 8vw, 5rem); 
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 1rem; 
    letter-spacing: -2px;
    background: linear-gradient(to bottom, #fff 40%, #888);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  h1 span { 
    background: linear-gradient(90deg, #00d2ff, #3a7bd5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }
  
  header p { 
    color: #a0a0a0; 
    font-size: 1.2rem; 
  }
  
  /* Sections et Cartes animées */
  .project-detail { 
    margin-top: 4rem; 
    display: flex; 
    flex-direction: column; 
    gap: 2rem; 
  }
  
  .card { 
    background: rgba(255, 255, 255, 0.05); 
    border: 1px solid rgba(255, 255, 255, 0.1); 
    padding: 2rem; 
    border-radius: 20px; 
    opacity: 0; /* Départ invisible pour l'animation */
    animation: fadeIn 0.8s ease-out 0.3s forwards; /* Applique l'animation avec 0.3s de délai */
  }
  
  .card h2 { 
    color: #00d2ff; 
    margin-top: 0; 
  }
  
  .card ul { 
    color: #888; 
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  
  /* Style du bouton PDF */
  .btn-pdf {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(0, 210, 255, 0.1);
    border: 1px solid #00d2ff; /* Bordure bleue directement intégrée */
    color: #00d2ff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-pdf:hover {
    background: #00d2ff;
    color: #050505;
    transform: translateY(-2px);
  }
  
  /* Effet de fond lumineux */
  .glow-overlay {
    position: fixed;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    background: radial-gradient(circle at 50% -20%, rgba(0, 210, 255, 0.15), transparent 50%);
    pointer-events: none;
    z-index: -1;
  }
  
  .badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 5px 12px;
  background: rgba(255, 255, 255, 0.05);
  color: #888;
  border-radius: 100px; /* Effet pillule */
  margin-bottom: 1rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.card:hover .badge {
  color: #00d2ff;
  border-color: #00d2ff;
  background: rgba(0, 210, 255, 0.05);
}

.card {
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Aligne le badge et le bouton à gauche */
}
  
  	/* Masquer la scrollbar pour Chrome, Safari et Opera */
::-webkit-scrollbar {
    display: none;
}

/* Masquer la scrollbar pour IE, Edge et Firefox */
* {
    -ms-overflow-style: none;  /* IE et Edge */
    scrollbar-width: none;     /* Firefox */
}

  /* --- DEFINITION DE L'ANIMATION --- */
  @keyframes fadeIn {
    from { 
      opacity: 0; 
      transform: translateY(30px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }
  /* Effet cascade pour l'apparition des cartes */
  .card:nth-child(1) { animation-delay: 0.2s; }
  .card:nth-child(2) { animation-delay: 0.4s; }
  .card:nth-child(3) { animation-delay: 0.6s; }
  
  	/* Footer & Animations */
	footer { margin-top: 10rem; padding-bottom: 4rem; text-align: center; color: #444; }
</style>