---
import Layout from '../layouts/Layout.astro';
import Status from '../components/Status.astro';

// Données extraites
const name = "Romain Miazga";
const jobTitle = "Technicien Informatique de Proximité en formation";
const description = "Actuellement en formation à la Metz Numeric School";
---

<Layout title={`${name} | Technicien Informatique`} description={description}>
	<div class="glow-overlay"></div>

	<main>
		<header class="hero">
			<div class="badge">Bienvenue sur mon Portfolio</div>
			<h1>{name}</h1>

			<p class="tagline">{jobTitle}</p>
			<p class="bio">{description}</p>
			
			<div class="actions">
				<a href="mailto:romain.miazga@gmail.com" class="btn btn-primary">
					<span>Me contacter</span>
				</a>
				<a href="/CV_MIAZGA_Romain_Technicien_Informatique.pdf" class="btn btn-outline" target="_blank">
					Consulter mon CV
				</a>
			</div>
		</header>

		<section class="about ">
			<div class="section-header hidden-scroll">
				<h2>À propos</h2>
				<div class="line"></div>
			</div>
			
			<div class="about-container hidden-scroll">
				<div class="about-photo hidden-scroll">
					<img src="/romain-miazga.webp" alt="Portrait de Romain Miazga" />
					<div class="photo-glow"></div>
				</div>

				<div class="about-content hidden-scroll">
					<p>
						Passionné par l'informatique depuis toujours, j'ai décidé de transformer cet intérêt en expertise professionnelle en intégrant la <strong>Metz Numeric School</strong>. 
						Mon parcours précédent dans le commerce m'a doté d'un sens du service client et d'une grande réactivité face aux imprévus.
					</p>
					<p>
						Aujourd'hui, je me concentre sur la maîtrise des infrastructures réseau et du support technique. Mon objectif est d'apporter des solutions concrètes et pédagogiques aux utilisateurs, tout en garantissant la stabilité des systèmes.
					</p>
				</div>
			</div>
		</section>



		<section class="skills">
			<div class="section-header hidden-scroll">
				<h2>Compétences Techniques</h2>
				<div class="line"></div>
			</div>
			<div class="grid">
				<div class="card hidden-scroll">
					<div class="icon">💻</div>
					<h3>Systèmes & OS</h3>
					<p>Maîtrise Windows Client/Serveur (AD, GPO, NTFS) et environnements Linux Debian/Ubuntu.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon">🌐</div>
					<h3>Réseau Cisco</h3>
					<p>Configuration de VLAN, routage et commutation via Packet Tracer. Adressage IPv4/IPv6.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon hidden-scroll">☁️</div>
					<h3>Virtualisation</h3>
					<p>Déploiement de machines virtuelles sous VMware, Proxmox et gestion de stockage TrueNAS.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon">🛠️</div>
					<h3>Maintenance & Support</h3>
					<p>Diagnostic hardware, gestion des priorités via GLPI et assistance physique ou à distance.</p>
				</div>
			</div>
		</section>
		
		<section class="env">
			<div class="section-header hidden-scroll">
				<h2>Environnement de Travail</h2>
				<div class="line"></div>
			</div>
			<div class="grid">
				<div class="card hidden-scroll">
					<h3>🖥️ OS de travail</h3>
					<p>Utilisation quotidienne de <strong>Debian 13</strong> pour le développement et <strong>Windows 11</strong> pour le support client.</p>
				</div>
				<div class="card hidden-scroll">
					<h3>⌨️ Ligne de commande</h3>
					<p>Maîtrise du terminal via <strong>PuTTY</strong> et gestion distante sécurisée avec <strong>SSH</strong>.</p>
				</div>
				<div class="card hidden-scroll">
					<h3>📁 Transfert & Flux</h3>
					<p>Gestion de fichiers via <strong>WinSCP</strong> (SFTP) et outils d'analyse réseau comme <strong>Nmap</strong>.</p>
				</div>
				<div class="card hidden-scroll">
					<h3>🔧 Outils Support</h3>
					<p>Utilisation de <strong>GLPI</strong> pour le ticketing et <strong>Ventoy/Rufus</strong> pour la masterisation de postes.</p>
				</div>
			</div>
		</section>

		<section class="soft-skills">
			<div class="section-header hidden-scroll">
				<h2>Atouts & Savoir-être</h2>
				<div class="line"></div>
			</div>
			<div class="grid">
				<div class="card hidden-scroll">
					<div class="icon">🤝</div>
					<h3>Relation Client</h3>
					<p>Capacité d'écoute et pédagogie pour accompagner les utilisateurs dans la résolution de leurs problèmes.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon">⚡</div>
					<h3>Gestion du Stress</h3>
					<p>Réactivité et sang-froid face aux urgences techniques, acquis lors de mes expériences en commerce.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon">👥</div>
					<h3>Esprit d'Équipe</h3>
					<p>Habitué au travail collaboratif et au respect des consignes de sécurité en environnement exigeant.</p>
				</div>
				<div class="card hidden-scroll">
					<div class="icon">⏱️</div>
					<h3>Rigueur & Ponctualité</h3>
					<p>Sens des responsabilités, gestion des priorités et respect strict des protocoles d'intervention.</p>
				</div>
			</div>
		</section>

		<section class="certs">
			<div class="section-header hidden-scroll">
				<h2>Certifications & Formation</h2>
				<div class="line"></div>
			</div>
			
			<div class="cert-grid hidden-scroll">
				<a href="https://www.credly.com/users/romain-miazga/badges#credly" target="_blank" class="cert-card">
					<div class="cert-content hidden-scroll">
						<div class="cert-badge-icon">
							<img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Cisco_logo_blue_2016.svg" alt="Cisco Logo" />
						</div>
						<div class="cert-info">
							<strong>Cisco Networking Academy</strong>
							<p>Configuration, Adressage et Dépannage Réseau</p>
							<span class="verify-tag">Vérifier les badges →</span>
						</div>
					</div>
				</a>

				<a href="https://openbadgefactory.com/v1/assertion/dcc9bbc15479f615a5a736e278e4c4e4a7d33d81.html" target="_blank" class="cert-card">
					<div class="cert-content hidden-scroll">
						<div class="cert-badge-icon school">🎓</div>
						<div class="cert-info">
							<strong>Metz Numeric School</strong>
							<p>Initié au numérique By Num & Boost</p>
							<span class="verify-tag">Vérifier le badge →</span>
						</div>
					</div>
				</a>
			</div>
		</section>
	</main>

</Layout>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');

	:root {
		--bg: #050505;
		--text: #ffffff;
		--accent: #00d2ff;
		--accent-2: #3a7bd5;
		--card-bg: rgba(255, 255, 255, 0.05);
		--card-border: rgba(255, 255, 255, 0.1);
		--font: 'Plus Jakarta Sans', sans-serif;
	}

	* { box-sizing: border-box; }

	body {
		font-family: var(--font);
		background-color: var(--bg);
		color: var(--text);
		margin: 0;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
	}

	.glow-overlay {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		background: radial-gradient(circle at 50% -20%, rgba(0, 210, 255, 0.15), transparent 50%);
		pointer-events: none;
		z-index: -1;
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	/* Hero Section */
	.hero {
		text-align: center;
		padding: 6rem 0;
		animation: fadeIn 1s ease-out;
	}

	.badge {
		background: rgba(0, 210, 255, 0.1);
		color: var(--accent);
		padding: 0.5rem 1rem;
		border-radius: 99px;
		font-size: 0.8rem;
		font-weight: 600;
		display: inline-block;
		margin-bottom: 2rem;
		border: 1px solid rgba(0, 210, 255, 0.2);
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 800;
		margin: 0;
		letter-spacing: -2px;
		background: linear-gradient(to bottom, #fff 40%, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.tagline {
		font-size: 1.5rem;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 700;
		margin: 1rem 0;
	}

	.bio {
		max-width: 650px;
		margin: 0 auto;
		color: #a0a0a0;
		font-size: 1.1rem;
		line-height: 1.6;
	}

	/* Buttons */
	.actions {
		margin-top: 3rem;
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}

	.btn {
		padding: 1rem 2rem;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.btn-primary { background: var(--text); color: var(--bg); }
	.btn-outline { border: 1px solid var(--card-border); color: var(--text); backdrop-filter: blur(10px); }
	.btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.4); }

	/* Sections Headers */
	.section-header {
		margin-top: 8rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.line { height: 1px; background: var(--card-border); flex-grow: 1; }

	/* About Section avec Image */
	.about-container {
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: 3rem;
		align-items: center;
		max-width: 950px;
		margin: 0 auto;
	}

	.about-photo {
		position: relative;
		display: flex;
		justify-content: center;
	}

/* Ce CSS cible directement l'image dans votre conteneur */
.about-photo img {
    /* Étape 1 : Assurer que l'image prend bien toute la place de sa colonne grid */
    width: 300px; /* La largeur définie dans grid-template-columns */
    height: 300px; /* Pour un rendu carré ou circulaire */
    
    /* Étape 2 : Le navigateur doit remplir la zone, mais l'image sera recadrée */
    object-fit: cover; 

    /* Étape 3 (LA SOLUTION) : Forcer le cadrage sur le haut de la photo */
    /* Cela veut dire : "Affiche 0% horizontalement (centré), mais 0% verticalement (le haut)" */
    object-position: 40% 0%; 
    /* Ou plus simplement : object-position: top; */

    /* Étape 4 (Esthétique - pour matcher votre style actuel) */
    border-radius: 999px; /* Forme circulaire, plus humaine pour un portrait */
    border: 3px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
}

/* Optionnel : Lueur bleue au survol de la photo */
.about-photo:hover img {
    border-color: var(--accent);
    transform: translateY(-5px) scale(1.02);
}

	.photo-glow {
		position: absolute;
		width: 120%;
		height: 120%;
		background: radial-gradient(circle, rgba(0, 210, 255, 0.15), transparent 70%);
		z-index: 0;
	}

	.about-content {
		font-size: 1.15rem;
		line-height: 1.8;
		color: #a0a0a0;
		text-align: left;
	}

	.about-content strong { color: var(--accent); }

	/* Grid & Cards */
	.grid {
		text-align: center;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 2.5rem;
		border-radius: 24px;
		transition: all 0.4s ease;
	}

	.card:hover {
		border-color: var(--accent);
		transform: translateY(-5px);
		box-shadow: 0 10px 30px rgba(0, 210, 255, 0.1);
	}

	.icon {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
		display: inline-block;
		animation: float 4s ease-in-out infinite;
	}

	/* Certifications */
	.cert-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.cert-card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 1.5rem;
		border-radius: 20px;
		text-decoration: none;
		color: inherit;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		display: block;
		position: relative;
		overflow: hidden;
	}

	.cert-card:hover {
		border-color: var(--accent);
		background: rgba(0, 210, 255, 0.05);
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
	}

	.cert-content {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.cert-badge-icon {
		width: 60px;
		height: 60px;
		background: rgba(255, 255, 255, 0.03);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.cert-badge-icon img { width: 40px; height: auto; }
	.cert-badge-icon.school { font-size: 2rem; }

	.cert-info strong {
		display: block;
		font-size: 1.1rem;
		color: #fff;
		margin-bottom: 0.2rem;
	}

	.cert-info p { margin: 0; font-size: 0.9rem; color: #a0a0a0; }

	.verify-tag {
		display: inline-block;
		margin-top: 0.8rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--accent);
		letter-spacing: 1px;
	}
	

	
	/* --- ANIMATIONS AU SCROLL --- */
.hidden-scroll {
    opacity: 0;
    transform: translateY(40px); /* L'élément est un peu plus bas */
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
}

.show-scroll {
    opacity: 1;
    transform: translateY(0); /* L'élément remonte à sa place */
}

/* Effet cascade pour les grilles (les cartes apparaissent une par une) */
.grid .card:nth-child(1) { transition-delay: 0.1s; }
.grid .card:nth-child(2) { transition-delay: 0.2s; }
.grid .card:nth-child(3) { transition-delay: 0.3s; }
.grid .card:nth-child(4) { transition-delay: 0.4s; }

.cert-grid .cert-card:nth-child(1) { transition-delay: 0.1s; }
.cert-grid .cert-card:nth-child(2) { transition-delay: 0.2s; }
	
	

	/* Scrollbar Hiding */
	::-webkit-scrollbar { display: none; }
	* { -ms-overflow-style: none; scrollbar-width: none; }

	/* Footer & Animations */
	footer { margin-top: 10rem; padding-bottom: 4rem; text-align: center; color: #444; }

	@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
	@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

	@media (max-width: 900px) {
		.about-container { grid-template-columns: 1fr; text-align: center; }
		.about-content { text-align: left; }
		.about-photo { margin-bottom: 1rem; }
		
	}

/* --- TABLETTES ET PETITS ÉCRANS (900px et moins) --- */
@media (max-width: 900px) {
    .about-container { 
        grid-template-columns: 1fr; 
        text-align: center; 
        gap: 2rem;
    }
    .about-photo { margin-bottom: 1rem; }
    /* On garde le texte de description à gauche pour la lisibilité */
    .about-content { text-align: left; padding: 0 10px; }
}

/* --- SMARTPHONES (768px et moins) --- */
@media (max-width: 768px) {
    /* Centrage de tous les headers de section (À propos, Compétences, etc.) */
    .section-header {
        flex-direction: column;
        align-items: center; /* CENTRE tout le monde */
        text-align: center;
        gap: 0.8rem;
        margin-top: 5rem;
        margin-bottom: 2.5rem;
    }

    .section-header h2 {
        font-size: 1.8rem;
        letter-spacing: -0.5px;
        background: linear-gradient(to bottom, #ffffff, #a0a0a0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* La petite barre dégradée centrée */
    .section-header .line {
        width: 40px;
        height: 4px;
        background: linear-gradient(90deg, var(--accent), var(--accent-2));
        flex-grow: 0;
        border-radius: 10px;
    }
}

/* --- TRÈS PETITS ÉCRANS (600px et moins) --- */
@media (max-width: 600px) {
    main { padding: 4rem 1.5rem; }
    
    /* Boutons en plein écran pour faciliter le clic au pouce */
    .actions { flex-direction: column; width: 100%; gap: 1rem; }
    .btn { width: 100%; text-align: center; }
    
    h1 { font-size: 2.5rem; }
    
    .cert-content { flex-direction: column; text-align: center; }

    /* Suppression de l'align-items: flex-start qui cassait le centrage précédent */
}
	.about-content {
		text-align: center;
	}

</style>