---
// Données extraites [cite: 1, 2, 9, 25]
const name = "Romain Miazga";
const jobTitle = "Technicien Informatique de Proximité en formation";
const description = "Actuellement en formation à la Metz Numeric School";
import Navbar from '../components/Navbar.astro';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{name} | Portfolio Technicien</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
	</head>
	<body>
	<Navbar /> <div class="glow-overlay"></div>
		<div class="glow-overlay"></div>

		<main>
			<header class="hero">
				<div class="badge">Bienvenue sur mon Portfolio</div>
				<h1>{name}</h1>
				<p class="tagline">{jobTitle}</p>
				<p class="bio">{description}</p>
				
				<div class="actions">
					<a href="mailto:romain.miazga@gmail.com" class="btn btn-primary">
						<span>Me contacter</span>
					</a>
					<a href="/CV_MIAZGA_Romain_Technicien_Informatique.pdf" class="btn btn-outline" target="_blank">
						Consulter mon CV
					</a>
				</div>
			</header>

			<section class="skills">
				<div class="section-header">
					<h2>Compétences Techniques</h2>
					<div class="line"></div>
				</div>
				<div class="grid">
					<div class="card">
						<div class="icon">💻</div>
						<h3>Systèmes & OS</h3>
						<p>Maîtrise Windows Client/Serveur (AD, GPO, NTFS) et environnements Linux Debian/Ubuntu.</p>
					</div>
					<div class="card">
						<div class="icon">🌐</div>
						<h3>Réseau Cisco</h3>
						<p>Configuration de VLAN, routage et commutation via Packet Tracer. Adressage IPv4/IPv6.</p>
					</div>
					<div class="card">
						<div class="icon">☁️</div>
						<h3>Virtualisation</h3>
						<p>Déploiement de machines virtuelles sous VMware, Proxmox et gestion de stockage TrueNAS.</p>
					</div>
					<div class="card">
						<div class="icon">🛠️</div>
						<h3>Maintenance & Support</h3>
						<p>Diagnostic hardware, gestion des priorités via GLPI et assistance physique ou à distance.</p>
					</div>
				</div>
			</section>
			<section class="env">
				<div class="section-header">
					<h2>Environnement de Travail</h2>
					<div class="line"></div>
				</div>
				<div class="grid">
					<div class="card">
						<h3>🖥️ OS de travail</h3>
						<p>Utilisation quotidienne de <strong>Debian 13</strong> pour le développement et <strong>Windows 11</strong> pour le support client.</p>
					</div>
					<div class="card">
						<h3>⌨️ Ligne de commande</h3>
						<p>Maîtrise du terminal via <strong>PuTTY</strong> et gestion distante sécurisée avec <strong>SSH</strong>.</p>
					</div>
					<div class="card">
						<h3>📁 Transfert & Flux</h3>
						<p>Gestion de fichiers via <strong>WinSCP</strong> (SFTP) et outils d'analyse réseau comme <strong>Nmap</strong>.</p>
					</div>
					<div class="card">
						<h3>🔧 Outils Support</h3>
						<p>Utilisation de <strong>GLPI</strong> pour le ticketing et <strong>Ventoy/Rufus</strong> pour la masterisation de postes.</p>
					</div>
				</div>
			</section>

<section class="soft-skills">
				<div class="section-header">
					<h2>Atouts & Savoir-être</h2>
					<div class="line"></div>
				</div>
				<div class="grid">
					<div class="card">
						<div class="icon">🤝</div>
						<h3>Relation Client</h3>
						<p>Capacité d'écoute et pédagogie pour accompagner les utilisateurs dans la résolution de leurs problèmes.</p>
					</div>
					<div class="card">
						<div class="icon">⚡</div>
						<h3>Gestion du Stress</h3>
						<p>Réactivité et sang-froid face aux urgences techniques, acquis lors de mes expériences en commerce.</p>
					</div>
					<div class="card">
						<div class="icon">👥</div>
						<h3>Esprit d'Équipe</h3>
						<p>Habitué au travail collaboratif et au respect des consignes de sécurité en environnement exigeant.</p>
					</div>
					<div class="card">
						<div class="icon">⏱️</div>
						<h3>Rigueur & Ponctualité</h3>
						<p>Sens des responsabilités, gestion des priorités et respect strict des protocoles d'intervention.</p>
					</div>
				</div>
			</section>

			<section class="certs">
				<div class="section-header">
					<h2>Certifications & Formation</h2>
					<div class="line"></div>
				</div>
				<div class="cert-list">
					<div class="cert-item">
						<strong>Cisco Networking Academy</strong>
						<span>Équipements, configuration et dépannage réseau</span>
					</div>
					<div class="cert-item">
						<strong>Metz Numeric School</strong>
						<span>Initié au numériqe By Num & Boost, Formation de TIP en cours</span>
					</div>
				</div>
			</section>
		</main>

		<footer>
			<p>© {new Date().getFullYear()} — Romain Miazga • Fameck (57)</p>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #050505;
		--text: #ffffff;
		--accent: #00d2ff;
		--accent-2: #3a7bd5;
		--card-bg: rgba(255, 255, 255, 0.05);
		--card-border: rgba(255, 255, 255, 0.1);
		--font: 'Plus Jakarta Sans', sans-serif;
	}

	* { box-sizing: border-box; }

	body {
		font-family: var(--font);
		background-color: var(--bg);
		color: var(--text);
		margin: 0;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
	}

	.glow-overlay {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		background: radial-gradient(circle at 50% -20%, rgba(0, 210, 255, 0.15), transparent 50%);
		pointer-events: none;
		z-index: -1;
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.hero {
		text-align: center;
		padding: 6rem 0;
		animation: fadeIn 1s ease-out;
	}

	.badge {
		background: rgba(0, 210, 255, 0.1);
		color: var(--accent);
		padding: 0.5rem 1rem;
		border-radius: 99px;
		font-size: 0.8rem;
		font-weight: 600;
		display: inline-block;
		margin-bottom: 2rem;
		border: 1px solid rgba(0, 210, 255, 0.2);
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 800;
		margin: 0;
		letter-spacing: -2px;
		background: linear-gradient(to bottom, #fff 40%, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.tagline {
		font-size: 1.5rem;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 700;
		margin: 1rem 0;
	}

	.bio {
		max-width: 650px;
		margin: 0 auto;
		color: #a0a0a0;
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.actions {
		margin-top: 3rem;
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}

	.btn {
		padding: 1rem 2rem;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.btn-primary {
		background: var(--text);
		color: var(--bg);
	}

	.btn-outline {
		border: 1px solid var(--card-border);
		color: var(--text);
		backdrop-filter: blur(10px);
	}

	.btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.4);
	}

	.section-header {
		margin-top: 8rem;
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.line { height: 1px; background: var(--card-border); flex-grow: 1; }

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		padding: 2.5rem;
		border-radius: 24px;
		transition: all 0.4s ease;
	}

.card:hover {
		border-color: var(--accent);
		transform: translateY(-5px);
		box-shadow: 0 10px 30px rgba(0, 210, 255, 0.1);
	}
	
	.card:active {
		transform: scale(0.98);
		background: rgba(255, 255, 255, 0.08);
		border-color: var(--accent);
	}

@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	.icon { 
		font-size: 2.5rem; 
		margin-bottom: 1.5rem; 
		display: inline-block;
		animation: float 4s ease-in-out infinite; 
	}

	.cert-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.cert-item {
		background: var(--card-bg);
		padding: 1.5rem;
		border-radius: 16px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		border: 1px solid var(--card-border);
	}

	.cert-item strong { color: var(--accent); }

	footer {
		margin-top: 10rem;
		padding-bottom: 4rem;
		text-align: center;
		color: #444;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}

@media (max-width: 600px) {
		main { padding: 5rem 1.5rem 2rem 1.5rem; }
		.actions { flex-direction: column; width: 100%; }
		.btn { width: 100%; text-align: center; }
		.section-header { margin-top: 4rem; flex-direction: column; align-items: flex-start; gap: 0.5rem; }
		.cert-item { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
		h1 { font-size: 2.5rem; }
	}
</style>